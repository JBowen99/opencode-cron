FROM node:22-alpine AS build
ENV CI=true
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@12.11.2 --activate
WORKDIR /src
COPY package.json pnpm-lock.yaml tsconfig.json ./
RUN pnpm install --frozen-lockfile
COPY src src
COPY shared shared
COPY sandbox sandbox
RUN pnpm exec tsc -p tsconfig.json

FROM node:22-alpine
RUN apk add --no-cache bash ca-certificates curl git libstdc++ \
  && adduser -D -u 1001 -h /home/sandbox sandbox \
  && mkdir -p /workspaces /home/sandbox/.local/share /home/sandbox/.config \
  && curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path \
  && cp /root/.opencode/bin/opencode /usr/local/bin/opencode \
  && chmod 755 /usr/local/bin/opencode \
  && chown -R sandbox:sandbox /workspaces /home/sandbox
WORKDIR /app
COPY --from=build /src/dist/sandbox ./sandbox
COPY --from=build /src/dist/shared ./shared
ENV HOME=/home/sandbox
ENV XDG_DATA_HOME=/home/sandbox/.local/share
ENV XDG_CONFIG_HOME=/home/sandbox/.config
ENV PATH="/usr/local/bin:${PATH}"
ENV PORT=8788
ENV HOST=0.0.0.0
ENV WORKSPACE_ROOT=/workspaces
USER sandbox
EXPOSE 8788
CMD ["node", "sandbox/server.js"]
